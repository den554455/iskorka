# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Путь к базе SQLite (создаётся автоматически при первом запуске)
DATABASE_URL=sqlite:///./data/iskorka.db

# Секретная «соль» для хэширования идентификатора игрока. ОБЯЗАТЕЛЬНО замените.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
PLAYER_KEY_PEPPER=

# Необязательно: если задать, webhook будет по адресу /alice/<секрет>
WEBHOOK_SECRET=

MAX_BODY_BYTES=65536
LOG_LEVEL=INFO
